---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description, image = '/images/hero-daylight.jpg' } = Astro.props;
const pageTitle = title === 'Home' ? 'Ghost Subie Adventures | Preparedness Without Panic' : `${title} | Ghost Subie Adventures`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f1e5" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? 'Ghost Subie Adventures — preparedness without panic. Family overlanding, real-world readiness, and stories from the road.'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? 'Preparedness without panic.'} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --cream: #f6f1e5;
    --cream-2: #eee5cf;
    --paper: #fffdf7;
    --ink: #1e1a14;
    --muted: #6f6553;
    --rust: #c2511f;
    --rust-dark: #9c3e13;
    --rust-soft: #e8a06a;
    --olive: #3c4732;
    --olive-2: #323b2a;
    --black: #14110c;
    --line: #ded2b8;
    /* Legacy aliases from the previous theme — mapped into the mockup system */
    --card: #fffdf7;
    --radius: 4px;
    --amber: #c2511f;
    --text: #1e1a14;
    --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    --font-body: 'Inter', -apple-system, 'Segoe UI', sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    font-family: var(--font-body);
    background: var(--cream);
    color: var(--ink);
    line-height: 1.65;
    font-size: 1.06rem;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: 0.01em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  h1 { font-size: clamp(3.2rem, 7.5vw, 5.6rem); }
  h2 { font-size: clamp(2.4rem, 4.8vw, 3.6rem); }
  h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  p { margin: 0 0 1.1rem; }
  img { max-width: 100%; display: block; }
  a { color: var(--rust); }

  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  /* Kickers — small rust uppercase labels */
  .eyebrow {
    display: block;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 0.9rem;
  }

  .lead {
    font-size: clamp(1.08rem, 1.7vw, 1.28rem);
    line-height: 1.6;
    max-width: 44rem;
  }

  /* Buttons — rectangular, bold */
  .btn {
    display: inline-block;
    font-weight: 700;
    font-size: 1.02rem;
    padding: 1rem 1.9rem;
    border-radius: 0;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn-light { background: var(--paper); color: var(--ink); }
  .btn-light:hover { background: #ffffff; }
  .btn-dark { background: var(--ink); color: var(--paper); }
  .btn-dark:hover { background: #000; }
  .btn-rust { background: var(--rust); color: #fff; }
  .btn-rust:hover { background: var(--rust-dark); }
  .btn-outline {
    background: transparent;
    color: inherit;
    border: 2px solid currentColor;
    padding: calc(1rem - 2px) calc(1.9rem - 2px);
  }

  .rust-link {
    color: var(--rust);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }
  .rust-link:hover { color: var(--rust-dark); }

  .section { padding: 5rem 0; }
  .section-tight { padding: 3.5rem 0; }
  .center { text-align: center; }
  .center .lead { margin-left: auto; margin-right: auto; }

  .page-hero { padding: 4.5rem 0 3rem; max-width: 62rem; }
  .page-hero h1 { margin-bottom: 1.2rem; }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }

  /* Image cards with overlaid text (home Field Notes) */
  .overlay-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    text-decoration: none;
    min-height: 430px;
    color: #fff;
  }
  .overlay-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .overlay-card:hover > img { transform: scale(1.04); }
  .overlay-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 8, 5, 0.93) 0%, rgba(10, 8, 5, 0.55) 48%, rgba(10, 8, 5, 0.04) 78%);
  }
  .overlay-card .overlay-body {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 1.7rem;
    z-index: 1;
  }
  .overlay-card .eyebrow { color: var(--rust-soft); margin-bottom: 0.5rem; }
  .overlay-card h3 { color: #fff; margin-bottom: 0.5rem; }
  .overlay-card p { color: rgba(255,255,255,0.88); font-size: 0.97rem; margin-bottom: 0.8rem; }
  .overlay-card .card-link { color: #fff; font-weight: 700; }

  /* Plain content cards */
  .card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .card-body { padding: 1.8rem; }
  .card-body h3 { margin-bottom: 0.5rem; }
  .card-body p { color: var(--muted); font-size: 0.98rem; }
  .card-meta {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 0.6rem;
  }
  .card-link { color: var(--rust); font-weight: 700; text-decoration: none; }
  .card-link:hover { color: var(--rust-dark); text-decoration: underline; }

  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; }
  @media (max-width: 1020px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 860px) { .grid-3 { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .grid-4 { grid-template-columns: 1fr; } }

  /* Dark bands */
  .band-black { background: var(--black); color: var(--cream); }
  .band-olive { background: var(--olive); color: var(--cream); }
  .band-black h1, .band-black h2, .band-olive h1, .band-olive h2 { color: #fffdf7; }
  .band-black .lead, .band-olive .lead { color: rgba(246, 241, 229, 0.87); }

  .framed { border-radius: 4px; }

  .embed-shell {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    margin-top: 2rem;
  }
  .embed-shell iframe { display: block; width: 100%; border: 0; }
</style>
