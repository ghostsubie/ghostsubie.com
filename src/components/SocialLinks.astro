---
/* Shared social row — Instagram first, then TikTok and podcast apps.
 * Variants: "light" (default, ink on cream) and "dark" (cream on dark bands). */
interface Props {
  variant?: 'light' | 'dark';
  label?: string;
}
const { variant = 'light', label = 'Follow along' } = Astro.props;

const socials = [
  {
