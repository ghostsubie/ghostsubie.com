---

<div class={`social-row social-${variant}`}>
  <span class="social-label">{label}</span>
  <div class="social-icons">
    {socials.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener"
        class="social-link"
        aria-label={`Ghost Subie Adventures on ${s.name} (${s.handle})`}
        title={`${s.name} — ${s.handle}`}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={s.path}></path>
        </svg>
        <span class="social-name">{s.name}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .social-row { display: flex; flex-direction: column; gap: 0.7rem; }
  .social-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .social-light .social-label { color: var(--muted); }
  .social-dark .social-label { color: rgba(246, 241, 229, 0.7); }
  .social-icons { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 1rem 0.5rem 0.65rem;
    transition: transform 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .social-link svg { width: 20px; height: 20px; flex: none; }
  .social-light .social-link { color: var(--ink); background: var(--paper); }
  .social-light .social-link svg { fill: var(--ink); }
  .social-light .social-link:hover { border-color: var(--rust); color: var(--rust); transform: translateY(-2px); }
  .social-light .social-link:hover svg { fill: var(--rust); }
  .social-dark .social-link { color: var(--cream); border-color: rgba(246, 241, 229, 0.35); }
  .social-dark .social-link svg { fill: var(--cream); }
  .social-dark .social-link:hover { border-color: var(--rust-soft); color: var(--rust-soft); transform: translateY(-2px); }
  .social-dark .social-link:hover svg { fill: var(--rust-soft); }
</style>
