---
const nav = [
  { href: '/about', label: 'About' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/field-notes', label: 'Field Notes' },
  { href: '/partner', label: 'Partner' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-main">
      <p class="footer-brand">Ghost Subie Adventures</p>
      <p class="footer-tag">Preparedness Without Panic &middot; San Antonio, Texas</p>
      <p class="footer-copy">&copy; 2026 Ghost Subie Adventures</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer-nav">
        {nav.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--cream);
    border-top: 1px solid var(--line);
  }
  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
    flex-wrap: wrap;
  }
  .footer-brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.5vw, 3rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1;
    margin: 0 0 0.6rem;
    color: var(--ink);
  }
  .footer-tag { color: var(--muted); font-size: 0.98rem; margin: 0 0 1.2rem; }
  .footer-copy { margin: 0; color: var(--muted); font-size: 0.88rem; }
  .footer-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.6rem 1.8rem;
    flex-wrap: wrap;
    justify-content: flex-end;
    text-align: right;
  }
  .footer-nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .footer-nav a:hover { color: var(--rust); }
</style>
