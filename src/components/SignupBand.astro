---
/*
 * Campfire-list signup band.
 * Roman is setting up Kit (ConvertKit) himself. When the Kit form embed
 * code is ready, paste it inside the KIT_FORM_EMBED block below,
 * replacing the placeholder div.
 */
---

<section class="section band-dark signup-band">
  <div class="wrap center">
    <span class="eyebrow">The Campfire List</span>
    <h2>Join the campfire list</h2>
    <p class="lead">One email a week &mdash; trip reports, rig upgrades, podcast drops. No spam, no fluff.</p>

    <!-- KIT_FORM_EMBED: paste the Kit/ConvertKit form embed code here (replaces the div below). -->
    <div class="kit-slot" data-kit-slot="campfire-list">
      <p class="kit-soon">The campfire list opens soon &mdash; check back after launch.</p>
    </div>
  </div>
</section>

<style>
  .signup-band { margin-top: 0; }
  .kit-soon { color: var(--muted); font-style: italic; }
</style>
