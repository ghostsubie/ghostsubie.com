---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignupBand from '../components/SignupBand.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('field-notes')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const others = posts.filter((p) => p !== featured).slice(0, 2);
const homeCards = [featured, ...others];

const episodes = [
  {
    title: 'The Comeback: Why the Podcast Is Back',
    blurb: 'The story behind the relaunch and what\u2019s coming this season.',
  },
  {
    title: 'I Stole My Content Strategy From My Email Inbox',
    blurb: 'The exact system behind the new season \u2014 plus how you can steal it too.',
  },
  {
    title: 'Why I Love My Wheels & Feels Drawer System',
    blurb: 'The trunk upgrade that turned camp setup from chaos into a two-minute job.',
  },
];
---

<BaseLayout
  title="Home"
  description="Ghost Subie Adventures — Preparedness Without Panic. A daily-driven Subaru Forester, real family camping, and the podcast from the campfire."
>
  <!-- HERO -->
  <section class="hero">
    <img
      class="hero-bg"
      src="/images/hero-night-fire.jpg"
      alt="The Ghost, a white Subaru Forester with a rooftop tent, parked beside a glowing campfire at night"
      fetchpriority="high"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <span class="eyebrow">Preparedness Without Panic</span>
      <h1>The daily driver that disappears into the wild on weekends.</h1>
      <p class="hero-sub">
        I&rsquo;m Roman &mdash; San Antonio dad, Subaru overlander, and host of the Ghost Subie
        Adventures Podcast. The Ghost is our white Forester: school drop-offs on weekdays,
        off-grid family camp on weekends with my wife, my kid, and our friends. No trailer
        queen, no fluff &mdash; just a real rig living a real life.
      </p>
      <div class="hero-cta">
        <a href="/checklist" class="btn">Get Rig Ready</a>
        <a href="/podcast" class="quiet-link">Prefer to listen first?</a>
      </div>
    </div>
  </section>

  <!-- LATEST EPISODES -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">The Podcast</span>
          <h2>Latest episodes</h2>
        </div>
        <a href="/podcast" class="card-link">All episodes &rarr;</a>
      </div>
      <div class="grid-3">
        {episodes.map((ep) => (
          <article class="card">
            <div class="card-body">
              <span class="card-meta">Episode</span>
              <h3>{ep.title}</h3>
              <p>{ep.blurb}</p>
              <a href="/podcast" class="card-link">Listen &rarr;</a>
            </div>
          </article>
        ))}
      </div>
      <div class="embed-shell home-embed">
        <iframe
          src="https://embed.podcasts.apple.com/us/podcast/ghost-subie-adventures/id1874749799"
          height="450"
          title="Ghost Subie Adventures on Apple Podcasts"
          allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
          sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- FIELD NOTES -->
  <section class="section band-dark">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">From the Driver&rsquo;s Seat</span>
          <h2>Field Notes</h2>
        </div>
        <a href="/field-notes" class="card-link">Read them all &rarr;</a>
      </div>
      <div class="grid-3">
        {homeCards.map((post) => (
          <article class="card">
            {post.data.image && (
              <a href={`/field-notes/${post.id}`} aria-label={post.data.title}>
                <img class="card-img" src={post.data.image} alt={post.data.title} loading="lazy" />
              </a>
            )}
            <div class="card-body">
              <span class="card-meta">
                {post.data.featured ? 'Featured \u00b7 ' : ''}{post.data.category}
              </span>
              <h3><a href={`/field-notes/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <a href={`/field-notes/${post.id}`} class="card-link">Read the note &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- STORY SPLIT -->
  <section class="section">
    <div class="wrap split">
      <img
        class="framed"
        src="/images/family-selfie.jpg"
        alt="Roman with his wife Michelle and their son Jonah on a family camp night"
        loading="lazy"
        style="aspect-ratio: 4 / 3; object-position: 20% 80%;"
      />
      <div>
        <span class="eyebrow">Our Story, Short</span>
        <h2>It started with a Bluey car.</h2>
        <p class="lead">
          At our first Subiefest, my then-7-year-old spotted a Bluey-themed Subaru across the
          lot &mdash; and fell in love with the whole idea of it. Now the Ghost, our white
          Forester, is a daily driver by week and a family basecamp by weekend &mdash; and
          everything we learn out there comes back here.
        </p>
        <a href="/about" class="btn btn-outline">Read our story</a>
      </div>
    </div>
  </section>

  <!-- PARTNER BAND -->
  <section class="section band-dark center">
    <div class="wrap">
      <span class="eyebrow">Partner With Us</span>
      <h2>Take your brand off-road with us.</h2>
      <p class="lead">
        We display and demo partner gear at expos and car shows, feature it on the podcast,
        and put it through real family-camp testing on the blog.
      </p>
      <p><a href="/partner" class="btn">Work with us</a></p>
    </div>
  </section>

  <SignupBand />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 6, 4, 0.94) 0%, rgba(8, 6, 4, 0.55) 45%, rgba(8, 6, 4, 0.25) 100%);
  }
  .hero-content {
    position: relative;
    padding-bottom: 5.5rem;
    padding-top: 6rem;
    max-width: 1140px;
  }
  .hero-content h1 { max-width: 15ch; margin-bottom: 0.6rem; }
  .hero-sub { max-width: 38rem; color: #d8cdb6; font-size: 1.12rem; }
  .hero-cta { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; margin-top: 1.8rem; }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .section-head h2 { margin: 0; }
  .home-embed { margin-top: 2rem; }
</style>
