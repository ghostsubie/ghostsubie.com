---
import BaseLayout from '../../layouts/BaseLayout.astro';

const filters = ['All notes', 'Rig builds', 'Trip reports', 'Preparedness'];

const stack = [
  {
    eyebrow: 'Preparedness',
    title: 'Preparedness Without Panic',
    blurb: 'Readiness built around likely problems, useful skills, and a calm plan.',
    href: '/field-notes/what-preparedness-without-panic-actually-means',
  },
  {
    eyebrow: 'Family camp',
    title: 'The always-packed ten',
    blurb: 'The gear that earns a permanent place in the Ghost.',
    href: '/field-notes/10-things-i-pack-for-every-family-camp',
  },
  {
    eyebrow: 'Trip report',
    title: 'What the road taught us',
    blurb: 'The wins, misses, and changes that follow every camp.',
    href: null,
  },
];
---

<BaseLayout
  title="Field Notes"
  description="Field Notes — rig builds, trip reports, family camp systems, and preparedness lessons earned in the field. Written from the driver's seat, not the desk."
>
  <div class="wrap">
    <div class="page-hero">
      <span class="eyebrow">Field Notes</span>
      <h1>Written from the driver&rsquo;s seat, not the desk.</h1>
      <p class="lead">
        Rig builds, trip reports, family camp systems, and preparedness lessons earned in the
        field.
      </p>
      <p class="filters">
        {filters.map((f, i) => (
          <span class={i === 0 ? 'filter-pill active' : 'filter-pill'}>{f}</span>
        ))}
      </p>
    </div>

    <article class="card featured-card">
      <a href="/field-notes/why-i-love-my-wheels-and-feels-drawer-system" class="featured-img" aria-label="Why I Love My Wheels & Feels Drawer System">
        <img
          src="/images/field-drawer.jpg"
          alt="The Ghost&rsquo;s organized Wheels & Feels drawer and camp gear setup"
        />
      </a>
      <div class="card-body">
        <span class="card-meta">Featured rig build</span>
        <h2>
          <a href="/field-notes/why-i-love-my-wheels-and-feels-drawer-system">Why I Love My Wheels &amp; Feels Drawer System</a>
        </h2>
        <p>
          The real-world layout, access, and organization choices that keep the Ghost ready for
          errands, emergencies, and camp.
        </p>
        <a href="/field-notes/why-i-love-my-wheels-and-feels-drawer-system" class="card-link">Read the note &rarr;</a>
      </div>
    </article>

    <div class="note-stack">
      {stack.map((note) => (
        note.href ? (
          <a href={note.href} class="note-row">
            <span class="card-meta">{note.eyebrow}</span>
            <h3>{note.title}</h3>
            <p>{note.blurb}</p>
          </a>
        ) : (
          <div class="note-row">
            <span class="card-meta">{note.eyebrow}</span>
            <h3>{note.title}</h3>
            <p>{note.blurb}</p>
          </div>
        )
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .filters { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.2rem; }
  .filter-pill {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    border-radius: 0;
    padding: 0.5rem 1.1rem;
    color: var(--muted);
    background: var(--card);
  }
  .filter-pill.active { background: var(--black); border-color: var(--black); color: var(--cream); }
  .featured-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    margin-bottom: 2rem;
    border-top: 6px solid var(--black);
  }
  @media (max-width: 820px) { .featured-card { grid-template-columns: 1fr; } }
  .featured-img { display: block; position: relative; overflow: hidden; min-height: 340px; }
  .featured-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .featured-card .card-body { justify-content: center; padding: 2.2rem; }
  .featured-card h2 a { color: var(--text); text-decoration: none; }
  .featured-card h2 a:hover { color: var(--amber); }
  .note-stack { display: grid; gap: 1.2rem; padding-bottom: 4.5rem; }
  .note-row {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 6px solid var(--black);
    border-radius: 0;
    padding: 1.4rem 1.6rem;
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  a.note-row:hover { border-color: #4a3d28; transform: translateY(-3px); }
  .note-row h3 { margin: 0.4rem 0 0.4rem; color: var(--text); }
  .note-row p { color: var(--muted); margin: 0; }
</style>
