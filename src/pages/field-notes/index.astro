---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('field-notes')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.find((p) => p.data.featured);
const rest = posts.filter((p) => p !== featured);
const categories = [...new Set(posts.map((p) => p.data.category))];
---

<BaseLayout
  title="Field Notes"
  description="Field Notes — rig builds, trip reports, and preparedness lessons from Ghost Subie Adventures. Written from the driver's seat, not the desk."
>
  <div class="wrap">
    <div class="page-hero">
      <span class="eyebrow">The Blog</span>
      <h1>Field Notes</h1>
      <p class="lead">
        Rig builds, trip reports, and preparedness lessons &mdash; written from the
        driver&rsquo;s seat, not the desk.
      </p>
      <p class="categories">
        {categories.map((c) => (
          <span class="cat-pill">{c}</span>
        ))}
      </p>
    </div>

    {featured && (
      <article class="card featured-card">
        {featured.data.image && (
          <a href={`/field-notes/${featured.id}`} class="featured-img" aria-label={featured.data.title}>
            <img src={featured.data.image} alt={featured.data.title} />
          </a>
        )}
        <div class="card-body">
          <span class="card-meta">Featured &middot; {featured.data.category}</span>
          <h2><a href={`/field-notes/${featured.id}`}>{featured.data.title}</a></h2>
          <p>{featured.data.description}</p>
          <a href={`/field-notes/${featured.id}`} class="card-link">Read the note &rarr;</a>
        </div>
      </article>
    )}

    <div class="grid-3 notes-grid">
      {rest.map((post) => (
        <article class="card">
          {post.data.image && (
            <a href={`/field-notes/${post.id}`} aria-label={post.data.title}>
              <img class="card-img" src={post.data.image} alt={post.data.title} loading="lazy" />
            </a>
          )}
          <div class="card-body">
            <span class="card-meta">{post.data.category}</span>
            <h3><a href={`/field-notes/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <a href={`/field-notes/${post.id}`} class="card-link">Read the note &rarr;</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .categories { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.2rem; }
  .cat-pill {
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    color: var(--muted);
    background: var(--card);
  }
  .featured-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    margin-bottom: 2rem;
  }
  @media (max-width: 820px) { .featured-card { grid-template-columns: 1fr; } }
  .featured-img img { width: 100%; height: 100%; min-height: 280px; object-fit: cover; }
  .featured-card .card-body { justify-content: center; padding: 2.2rem; }
  .featured-card h2 a { color: var(--text); text-decoration: none; }
  .featured-card h2 a:hover { color: var(--amber); }
  .notes-grid { padding-bottom: 4.5rem; }
</style>
