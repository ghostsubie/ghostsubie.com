---
import BaseLayout from '../layouts/BaseLayout.astro';

const offerings = [
  {
    n: '01',
    eyebrow: 'Display',
    title: 'Expo & car-show display',
    body: 'Your product integrated into the Ghost\u2019s full setup at overland expos, Subiefest, and regional shows.',
  },
  {
    n: '02',
    eyebrow: 'Audio',
    title: 'Podcast features',
    body: 'Dedicated segments and full conversations on the Ghost Subie Adventures Podcast.',
  },
  {
    n: '03',
    eyebrow: 'Editorial',
    title: 'Reviews & build series',
    body: 'Long-form, photo-documented testing with space for context a quick reel can\u2019t hold.',
  },
  {
    n: '04',
    eyebrow: 'Social',
    title: 'Social content',
    body: 'Reels, carousels, and stories made for an engaged community that actually camps.',
  },
  {
    n: '05',
    eyebrow: 'Speaking',
    title: 'Speaking engagements',
    body: 'Practical, story-driven talks on vehicle preparedness, family adventure, and building real-world capability without panic.',
  },
  {
    n: '06',
    eyebrow: 'UGC',
    title: 'Custom UGC & content licensing',
    body: 'Ready-to-post photos and video of your product in real camp and overland use, licensed for your own channels.',
  },
  {
    n: '07',
    eyebrow: 'Web',
    title: 'Website & newsletter placements',
    body: 'Sponsored blog stories, a featured spot on our link-in-bio hub, and mentions in the Field Notes newsletter our community actually opens.',
  },
];

const mailto =
  'mailto:ghostsubieadventures@gmail.com?subject=' +
  encodeURIComponent('Partnership inquiry');
---

<BaseLayout
  title="Partner With Us"
  description="Partner with Ghost Subie Adventures — take your brand off-road with us. Expo displays, podcast features, real-world testing, website & newsletter placements, speaking, and licensed UGC."
>
  <div class="wrap">
    <div class="page-hero">
      <span class="eyebrow">Partner with us</span>
      <h1>Take your brand off-road with us.</h1>
      <p class="lead">
        The Ghost isn&rsquo;t a garage queen with a ring light. It&rsquo;s a daily-driven family
        rig that actually gets used. When we run your gear, it gets rained on, dusted,
        dog-haired, and kid-tested.
      </p>
    </div>
  </div>

  <img
    class="partner-bleed"
    src="/images/event-setup.jpg"
    alt="Roman leaning on the Ghost with the rooftop tent and awning deployed at an event"
    loading="lazy"
  />

  <div class="wrap">
    <section class="section-tight ways">
      <span class="eyebrow">Ways to work together</span>
      <h2 class="ways-head">One product. Many real touchpoints.</h2>
      <div class="grid-3 offerings">
        {offerings.map((o) => (
          <article class="card">
            <div class="card-body">
              <span class="card-meta">{o.n} &middot; {o.eyebrow}</span>
              <h3>{o.title}</h3>
              <p>{o.body}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="partner-cta-row"><a href={mailto} class="btn btn-dark">Start the conversation &rarr;</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .partner-bleed {
    width: 100%;
    max-height: 640px;
    object-fit: cover;
    display: block;
  }
  .ways { padding-bottom: 4.5rem; }
  .ways-head {
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    max-width: 16ch;
    margin-bottom: 2.4rem;
  }
  .offerings { margin-top: 0.5rem; }
  .partner-cta-row { margin: 2.4rem 0 0; }
</style>
