---
import BaseLayout from '../layouts/BaseLayout.astro';

const showUrl = 'https://podcasts.apple.com/us/podcast/ghost-subie-adventures/id1874749799';
const redcircleUrl = 'https://www.redcircle.com/shows/1c89c053-9573-49fe-a9c6-b34f4c6b449d';

const comingUp = [
  {
    title: 'Subaru Basecamp',
    blurb: 'The people, stories, and shared adventure behind the Basecamp experience.',
  },
  {
    title: 'Preparedness at the Movies',
    blurb: 'Breaking down what the screen gets right \u2014 and wrong \u2014 about real readiness.',
  },
  {
    title: 'Why I Love My Wheels & Feels Drawer System',
    blurb: 'The organization system that keeps the Ghost ready for daily life and weekends away.',
  },
];
---

<BaseLayout
  title="Podcast"
  description="Ghost Subie Adventures Podcast — real talk from a real rig. Family overlanding, preparedness without the panic, and conversations from the campfire."
>
  <div class="wrap">
    <div class="page-hero">
      <span class="eyebrow">The podcast</span>
      <h1>Real talk from a real rig.</h1>
      <p class="lead">
        Family overlanding, preparedness without the panic, and conversations with the people
        building the overland and Subaru community &mdash; recorded from the road, the
        campfire, and the driveway.
      </p>
    </div>

    <!-- LATEST EPISODE -->
    <section class="section-tight latest">
      <span class="card-meta">Latest episode &middot; 41 min</span>
      <h2>Fog is a Mindset</h2>
      <p class="lead">
        Navigating uncertainty, protecting situational awareness, and building resilience when
        visibility disappears.
      </p>
      <p class="latest-cta">
        <a href={showUrl} class="btn btn-dark" target="_blank" rel="noopener">Listen on Apple Podcasts &rarr;</a>
        <a href={redcircleUrl} class="btn btn-outline" target="_blank" rel="noopener">All episodes &amp; listening apps</a>
      </p>
      <div class="embed-shell">
        <iframe
          src="https://embed.podcasts.apple.com/us/podcast/ghost-subie-adventures/id1874749799"
          height="450"
          title="Ghost Subie Adventures on Apple Podcasts"
          allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
          sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
          loading="lazy"
        ></iframe>
      </div>
    </section>

    <!-- NEW SEASON -->
    <section class="section-tight">
      <span class="eyebrow">New season</span>
      <h2>The road ahead.</h2>
      <article class="card season-card">
        <div class="card-body">
          <span class="card-meta">Season return</span>
          <h3>The Comeback</h3>
          <p>
            Why the podcast is back, where it&rsquo;s headed, and why the best stories are the
            ones that get dirt on them.
          </p>
          <a href={redcircleUrl} class="card-link" target="_blank" rel="noopener">Follow the relaunch &rarr;</a>
        </div>
      </article>
    </section>

    <!-- COMING UP -->
    <section class="section-tight">
      <h2 class="coming-head">Coming up</h2>
      <div class="coming-rows">
        {comingUp.map((ep) => (
          <div class="coming-row">
            <span class="card-meta">Coming up</span>
            <h3>{ep.title}</h3>
            <p>{ep.blurb}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- BETWEEN EPISODES -->
    <section class="section-tight between-strip">
      <h2>Between episodes</h2>
      <p class="lead">
        Reels, camp clips, and Ghost updates land on Instagram first &mdash;
        <a
          class="rust-link"
          href="https://www.instagram.com/ghostsubieadventures"
          target="_blank"
          rel="noopener"
        >@ghostsubieadventures</a>.
      </p>
    </section>

    <!-- GUEST BAND -->
  </div><!-- /wrap -->
  <section class="section band-black center guest-band">
    <div class="wrap narrow">
      <span class="eyebrow">Have a story?</span>
      <h2>Pull up a chair.</h2>
      <p class="lead">
        We talk with overlanders, builders, Subaru people, and practical preparedness voices.
      </p>
      <p><a href="/contact" class="btn btn-rust">Pitch a guest &rarr;</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .latest h2 { margin: 0.6rem 0 0.8rem; }
  .latest-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.4rem 0 2rem; }
  .latest .embed-shell { margin-bottom: 1rem; }
  .season-card { margin-top: 1.6rem; }
  .coming-head { margin-bottom: 1.4rem; }
  .coming-rows { display: grid; gap: 1.2rem; margin-bottom: 1rem; }
  .coming-row {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
  }
  .coming-row h3 { margin: 0.4rem 0 0.4rem; }
  .coming-row p { color: var(--muted); margin: 0; }
  .between-strip h2 { margin-bottom: 0.4rem; }
  .between-strip .lead { color: var(--muted); }
  .guest-band { margin: 3rem 0 0; }
  .guest-band .narrow { max-width: 46rem; }
</style>
