---
import BaseLayout from '../layouts/BaseLayout.astro';

/*
 * Rig-Ready Checklist signup.
 * Roman is setting up Kit (ConvertKit) himself. When the Kit form embed
 * code is ready, paste it inside the KIT_FORM_EMBED block below,
 * replacing the mailto button.
 */

const inside = [
  'Six preparation sections',
  'A 60-second trailhead scan',
  'Emergency if-then prompts',
  'A practical $50 starter kit',
];

const mailto =
  'mailto:ghostsubieadventures@gmail.com?subject=' +
  encodeURIComponent('Send me the Rig-Ready Checklist');
---

<BaseLayout
  title="Free Rig-Ready Checklist"
  description="The Rig-Ready Checklist — the exact pre-trip scan we run before family camp. Free field guide from Ghost Subie Adventures."
>
  <section class="checklist-split">
    <div class="checklist-photo">
      <img
        src="/images/cargo-drawers.jpg"
        alt="The Ghost's loaded cargo bay with the wooden drawer system"
        fetchpriority="high"
      />
    </div>
    <div class="checklist-body">
      <span class="eyebrow">Free field guide</span>
      <h1>Don&rsquo;t hit the trail unprepared.</h1>
      <p class="lead">
        The Rig-Ready Checklist is the exact pre-trip scan we run before family camp: simple
        enough to use, specific enough to matter.
      </p>
      <ul class="dash-list">
        {inside.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

      <!-- KIT_FORM_EMBED: paste the Kit/ConvertKit form embed code here (replaces the mailto button below). -->
      <p class="kit-mailto">
        <a href={mailto} class="btn btn-dark btn-full">Ask for the checklist &rarr;</a>
      </p>

      <p class="fine-print">
        Free forever. One email a week after that. Unsubscribe anytime.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .checklist-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .checklist-photo { min-height: 480px; }
  .checklist-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .checklist-body {
    padding: clamp(3rem, 6vw, 5.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .checklist-body h1 { margin-bottom: 1.4rem; }
  .checklist-body .lead { color: var(--muted); margin-bottom: 0.5rem; }

  .dash-list {
    list-style: none;
    margin: 1.6rem 0 2.2rem;
    padding: 0;
  }
  .dash-list li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.08rem;
    font-weight: 500;
  }
  .dash-list li::before {
    content: '\2014';
    color: var(--rust);
    font-weight: 700;
  }

  .btn-full {
    display: block;
    width: 100%;
    text-align: center;
    padding: 1.15rem 1.9rem;
  }
  .kit-mailto { margin: 0 0 1.2rem; }
  .fine-print { color: var(--muted); font-size: 0.92rem; margin: 0; }

  @media (max-width: 860px) {
    .checklist-split { grid-template-columns: 1fr; }
    .checklist-photo { min-height: 0; }
    .checklist-photo img { max-height: 380px; }
  }
</style>
