---
import BaseLayout from '../../layouts/BaseLayout.astro';

const filters = [
  { label: 'All notes', value: 'all' },
  { label: 'Rig builds', value: 'rig-builds' },
  { label: 'Gear reviews', value: 'gear-reviews' },
  { label: 'Family camp', value: 'family-camp' },
  { label: 'Preparedness', value: 'preparedness' },
  { label: 'Trip reports', value: 'trip-reports' },
];

const stack = [
  {
    category: 'family-camp',
    eyebrow: 'Family camp',
    title: 'Overlanding With Kids: What Actually Works',
    blurb: 'Real-world tips for overlanding with kids — what works, what doesn’t, and what we’d never leave home without.',
    href: '/blog/overlanding-with-kids-what-actually-works',
  },
  {
    category: 'family-camp',
    eyebrow: 'Family camp',
    title: 'The Family Overland Packing List: What Earns Space in Our Forester',
    blurb: 'Our actual packing list — every item earns its spot next to a kid, a dog, and a drawer system.',
    href: '/blog/family-overland-packing-list',
  },
  {
    category: 'preparedness',
    eyebrow: 'Preparedness',
    title: 'Preparedness Without Panic',
    blurb: 'Readiness built around likely problems, useful skills, and a calm plan.',
    href: '/blog/what-preparedness-without-panic-actually-means',
  },
  {
    category: 'family-camp',
    eyebrow: 'Family camp',
    title: 'The always-packed ten',
    blurb: 'The gear that earns a permanent place in the Ghost.',
    href: '/blog/10-things-i-pack-for-every-family-camp',
  },
];
---

<BaseLayout
  title="From the Ghost"
  description="From the Ghost — rig builds, trip reports, family camp systems, and preparedness lessons earned in the field. Written from the driver's seat, not the desk."
  image="/images/story-campfire.jpg"
>
  <div class="wrap">
    <div class="page-hero">
      <span class="eyebrow">From the Ghost</span>
      <h1>Written from the driver&rsquo;s seat, not the desk.</h1>
      <p class="lead">
        Rig builds, trip reports, family camp systems, and preparedness lessons earned in the
        field.
      </p>
      <p class="filters">
        {filters.map((f, i) => (
          <button type="button" data-filter={f.value} class={i === 0 ? 'filter-pill active' : 'filter-pill'}>{f.label}</button>
        ))}
      </p>
    </div>

    <article class="card featured-card">
      <a href="/blog/can-you-overland-in-a-subaru-forester" class="featured-img" aria-label="Can You Overland in a Subaru Forester?">
        <img
          src="/images/forester-hero-brush.jpg"
          alt="The Ghost — a white Subaru Forester — pushing through the brush on the trail"
        />
      </a>
      <div class="card-body">
        <span class="card-meta">Featured post</span>
        <h2>
          <a href="/blog/can-you-overland-in-a-subaru-forester">Can You Overland in a Subaru Forester?</a>
        </h2>
        <p>
          What a base-model Forester is, what it isn&rsquo;t, what we changed, and what actually
          matters on the trail.
        </p>
        <a href="/blog/can-you-overland-in-a-subaru-forester" class="card-link">Read the note &rarr;</a>
      </div>
    </article>

    <div class="note-stack" id="note-stack">
      {stack.map((note) => (
        <a href={note.href} class="note-row" data-category={note.category}>
          <span class="card-meta">{note.eyebrow}</span>
          <h3>{note.title}</h3>
          <p>{note.blurb}</p>
        </a>
      ))}
      <div class="note-row empty-state" id="filter-empty" hidden>
        <span class="card-meta" id="filter-empty-eyebrow"></span>
        <h3 id="filter-empty-title"></h3>
        <p id="filter-empty-text"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const pills = document.querySelectorAll('[data-filter]');
  const rows = document.querySelectorAll('#note-stack [data-category]');
  const empty = document.getElementById('filter-empty');
  const emptyEyebrow = document.getElementById('filter-empty-eyebrow');
  const emptyTitle = document.getElementById('filter-empty-title');
  const emptyText = document.getElementById('filter-empty-text');
  const emptyMessages = {
    'trip-reports': {
      eyebrow: 'Trip reports',
      title: 'No trip reports yet',
      text: 'The Ghost rolls into Subiefest Midwest on Oct 10 — the recap lands right after. Stories incoming. 👻',
    },
    'gear-reviews': {
      eyebrow: 'Gear reviews',
      title: 'No gear reviews yet',
      text: 'The Kammok Crosswing review lands after Beyond City Limits (Oct 18). Real gear, real dirt, honest verdicts.',
    },
  };
  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      const f = pill.getAttribute('data-filter');
      let visible = 0;
      rows.forEach((row) => {
        const cats = row.getAttribute('data-category').split(' ');
        const show = f === 'all' || cats.includes(f);
        row.hidden = !show;
        if (show) visible++;
      });
      const msg = emptyMessages[f];
      if (visible === 0 && msg) {
        emptyEyebrow.textContent = msg.eyebrow;
        emptyTitle.textContent = msg.title;
        emptyText.textContent = msg.text;
        empty.hidden = false;
      } else {
        empty.hidden = true;
      }
    });
  });
</script>

<style>
  .filters { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.2rem; }
  .filter-pill {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    border-radius: 0;
    padding: 0.5rem 1.1rem;
    color: var(--muted);
    background: var(--card);
    cursor: pointer;
  }
  .filter-pill:hover { border-color: var(--black); color: var(--text); }
  .filter-pill.active { background: var(--black); border-color: var(--black); color: var(--cream); }
  .featured-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    margin-bottom: 2rem;
    border-top: 6px solid var(--black);
  }
  @media (max-width: 820px) { .featured-card { grid-template-columns: 1fr; } }
  .featured-img { display: block; position: relative; overflow: hidden; min-height: 340px; }
  .featured-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .featured-card .card-body { justify-content: center; padding: 2.2rem; }
  .featured-card h2 a { color: var(--text); text-decoration: none; }
  .featured-card h2 a:hover { color: var(--amber); }
  .note-stack { display: grid; gap: 1.2rem; padding-bottom: 4.5rem; }
  .note-row {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 6px solid var(--black);
    border-radius: 0;
    padding: 1.4rem 1.6rem;
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .note-row[hidden] { display: none; }
  a.note-row:hover { border-color: #4a3d28; transform: translateY(-3px); }
  .note-row h3 { margin: 0.4rem 0 0.4rem; color: var(--text); }
  .note-row p { color: var(--muted); margin: 0; }
  .empty-state { border-top-color: var(--amber); }
</style>
