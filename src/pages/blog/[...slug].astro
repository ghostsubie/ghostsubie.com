---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('field-notes');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const pubDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const postUrl = Astro.url.href;
const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image
    ? `https://ghostsubie.com${post.data.image}`
    : 'https://ghostsubie.com/images/hero-daylight.jpg',
  datePublished: post.data.pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Roman',
    url: 'https://ghostsubie.com/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Ghost Subie Adventures',
    logo: {
      '@type': 'ImageObject',
      url: 'https://ghostsubie.com/images/logo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />
  <div class="wrap">
    <article class="post">
      <p class="post-back"><a href="/blog" class="card-link">&larr; All From the Ghost</a></p>
      <span class="card-meta">{post.data.category} &middot; {pubDate}</span>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      {post.data.image && (
        <img class="post-hero framed-img" src={post.data.image} alt={post.data.title} />
      )}
      <div class="prose">
        <Content />
      </div>
      <div class="card cta-card">
        <div class="card-body">
          <span class="card-meta">Free field guide</span>
          <h3>Take the Rig-Ready Checklist on your next trip.</h3>
          <p>The exact pre-trip scan we run before family camp — free.</p>
          <p><a href="/checklist" class="btn btn-rust">Get the free checklist &rarr;</a></p>
        </div>
      </div>
      <p class="post-back bottom"><a href="/blog" class="card-link">&larr; All From the Ghost</a></p>
    </article>
  </div>
</BaseLayout>

<style>
  .post { max-width: 46rem; margin: 0 auto; padding: 3.5rem 0 4.5rem; }
  .post h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 0.5rem 0 0.8rem; }
  .post-back { margin: 0 0 1.4rem; }
  .post-back.bottom { margin: 3rem 0 0; }
  .post-hero { margin: 2rem 0; }
  .cta-card { margin-top: 3rem; text-align: center; }
  .cta-card p:last-child { margin-bottom: 0; }
  .framed-img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    object-fit: cover;
    max-height: 420px;
  }
</style>
