---
import BaseLayout from '../layouts/BaseLayout.astro';

/* ------------------------------------------------------------------
 * CONTACT — email lanes for now.
 * Roman hasn't chosen a form-handling service yet. The three lanes below
 * open a pre-addressed email. When he's ready, create a free form at
 * https://formspree.io (or similar) and swap a lane (or the whole grid)
 * for a <form> posting to the endpoint.
 * ------------------------------------------------------------------ */

const lanes = [
  {
    title: 'Brand & press',
    blurb: 'Partnerships, product testing, events',
    subject: 'Partnership inquiry',
  },
  {
    title: 'Podcast guest',
    blurb: 'Bring a story to the campfire',
    subject: 'Podcast guest pitch',
  },
  {
    title: 'Just saying hi',
    blurb: 'Subarus, trails, camp, gear',
    subject: 'Just saying hi',
  },
];

const mailto = (subject: string) =>
  'mailto:ghostsubieadventures@gmail.com?subject=' + encodeURIComponent(subject);
---

<BaseLayout
  title="Contact"
  description="Contact Ghost Subie Adventures — brand inquiries, podcast guest pitches, or just saying hi. Every note lands at base camp and gets a real reply."
  image="/images/about-basecamp.jpg"
>
  <div class="wrap">
    <div class="split contact-hero">
      <div class="page-hero">
        <span class="eyebrow">Contact</span>
        <h1>Say howdy.</h1>
        <p class="lead">
          Brand inquiry, podcast guest pitch, or just want to talk Subarus &mdash; pick a lane
          and drop us a note.
        </p>
      </div>
      <img
        class="framed"
        src="/images/about-basecamp.jpg"
        alt="Roman leaning on the Ghost beneath the Subaru Base Camp sign"
        loading="lazy"
      />
    </div>

    <section class="section-tight contact-lanes">
      <h2>Start with what brings you here.</h2>
      <p class="lead">Every note lands at base camp &mdash; and gets a real reply.</p>
      <div class="grid-3">
        {lanes.map((lane) => (
          <a href={mailto(lane.subject)} class="card lane-card">
            <div class="card-body">
              <h3>{lane.title}</h3>
              <p>{lane.blurb} &rarr;</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section-tight ig-strip">
      <h2>Faster than email? DM us.</h2>
      <p class="lead">
        We&rsquo;re on Instagram every day &mdash; reels, camp setups, and Ghost updates as they
        happen. Come say howdy:
        <a
          class="rust-link"
          href="https://www.instagram.com/ghostsubieadventures"
          target="_blank"
          rel="noopener"
        >@ghostsubieadventures</a>
      </p>
    </section>

    <section class="section-tight newsletter-cta">
      <h2>Want the Rig-Ready Checklist?</h2>
      <p class="lead">
        Join the list and we&rsquo;ll send the exact pre-trip scan we run before family camp &mdash;
        plus one email a week. Free forever, unsubscribe anytime.
      </p>
      <div class="kit-form">
        <script
          is:inline
          async
          data-uid="9cbc9b7c04"
          src="https://ghost-subie-adventures.kit.com/9cbc9b7c04/index.js"
        ></script>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-hero { padding: 3rem 0 1rem; }
  .contact-hero .page-hero { padding: 0; }
  .contact-hero img { width: 100%; height: 100%; max-height: 420px; object-fit: cover; }
  .contact-lanes { padding-bottom: 4.5rem; }
  .contact-lanes h2 { margin-bottom: 0.4rem; }
  .contact-lanes .lead { color: var(--muted); margin-bottom: 1.8rem; }
  .lane-card { text-decoration: none; }
  .lane-card h3 { margin: 0; }
  .lane-card .card-link, .lane-card p:last-child { color: var(--amber); font-weight: 600; }
  .ig-strip { padding-bottom: 4.5rem; }
  .ig-strip h2 { margin-bottom: 0.4rem; }
  .ig-strip .lead { color: var(--muted); }
  .newsletter-cta .lead { max-width: 60ch; }
  .newsletter-cta .kit-form { margin-top: 1.6rem; max-width: 560px; }
</style>
